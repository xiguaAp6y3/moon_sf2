name = "xiguaAp6y3/moon_sf2"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/xiguaAp6y3/moon_sf2"

license = "Apache-2.0"

keywords = [ "soundfont", "sf2", "midi", "synthesizer", "audio", "dsp" ]

preferred_target = "wasm"

description = "Pure MoonBit SoundFont2 (SF2) parser and General MIDI polyphonic wavetable synthesizer with zero C FFI."
